---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Contact | Sheriff">
  <section class="mx-auto max-w-7xl px-6 py-24">
    <p class="text-sm font-medium text-emerald-300">Contact</p>
    <h1
      class="mt-4 max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl"
    >
      Talk to us about Kubernetes governance.
    </h1>
    <p class="mt-8 max-w-2xl text-lg leading-8 text-slate-400">
      Tell us what you are trying to control, prove or simplify across your
      Kubernetes estate.
    </p>

    <a
      href="mailto:hello@sheriff.app"
      class="mt-10 inline-flex rounded-lg bg-emerald-400 px-5 py-3 font-medium text-black"
    >
      Email hello@sheriff.app
    </a>
  </section>
</Layout>
