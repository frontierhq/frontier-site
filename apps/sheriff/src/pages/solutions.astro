---
import Layout from '../layouts/Layout.astro'
import UseCases from '../components/UseCases.astro'
import CTA from '../components/CTA.astro'
---

<Layout title="Solutions | Sheriff">
  <section class="mx-auto max-w-7xl px-6 py-24">
    <p class="text-sm font-medium text-emerald-300">Solutions</p>
    <h1
      class="mt-4 max-w-4xl text-5xl font-semibold tracking-tight md:text-7xl"
