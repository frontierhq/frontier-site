---
import { sanity } from '../lib/sanity'

import CTASection from '../components/CTASection.astro'
import FeaturedCaseStudies from '../components/FeaturedCaseStudies.astro'
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro'
import PartnerEcosystem from '../components/PartnerEcosystem.astro'
import PlatformEstate from '../components/PlatformEstate.astro'
import WhatWeDo from '../components/WhatWeDo.astro'
import WhyProgressGetsHard from '../components/WhyProgressGetsHard.astro'

// import type { CaseStudy, Partner, Service } from '@frontier/sanity-types'

type HomePage = {
  title?: string
  seoTitle?: string
  seoDescription?: string
  hero?: Record<string, string>
}

// type HomeService = {
//   title: string
//   slug: {
//     current: string
//   }
//   summary?: string
// }

type HomePartner = {
  name: string
  slug?: {
    current: string
  }
}

type HomeCaseStudy = {
  title: string
  slug: {
    current: string
  }
  summary?: string
  clientType?: string
}

const page: HomePage | null = await sanity.fetch(`
  *[_type == "page" && slug.current == "home"][0]{
    title,
    hero
  }
`)

// const services: HomeService[] = await sanity.fetch(`
//   *[
//     _type == "service" &&
//     defined(slug.current)
//   ] | order(title asc){
//     title,
//     slug,
//     summary
//   }
// `)

const partners: HomePartner[] = await sanity.fetch(`
  *[
    _type == "partner" &&
    defined(slug.current)
  ] | order(name asc){
    name,
    slug
  }
`)

const caseStudies: HomeCaseStudy[] = await sanity.fetch(`
  *[
    _type == "caseStudy" &&
    defined(slug.current)
  ] | order(featured desc, title asc)[0...2]{
    title,
    slug,
    summary,
    clientType
  }
`)

const hero = page?.hero ?? {}
---

<Layout
  title={page?.seoTitle ??
    page?.title ??
    'Platform Engineering for Real-World Environments | FrontierHQ'}
  description={page?.seoDescription ??
    'Design, integration and hands-on platform engineering across bare metal, cloud, hybrid and Kubernetes environments.'}
  activeNav="/what-we-do"
>
  <main>
    <Hero {...hero} />

    <WhyProgressGetsHard />

    <WhatWeDo />

    <PlatformEstate />

    <PartnerEcosystem partners={partners} />

    <FeaturedCaseStudies caseStudies={caseStudies} />

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What does your platform need to make possible?"
      body="Tell us what you need to achieve. We’ll help you see the whole system, make risk visible and find a practical path forward."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
    />
  </main>
</Layout>
