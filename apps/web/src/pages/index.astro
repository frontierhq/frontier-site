---
import { sanity } from '../lib/sanity'

import CaseStudyCard from '../components/CaseStudyCard.astro'
import CTASection from '../components/CTASection.astro'
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro'
import PartnerStrip from '../components/PartnerStrip.astro'
import Section from '../components/Section.astro'
import ServiceCard from '../components/ServiceCard.astro'

const page = await sanity.fetch(`
  *[_type == "page" && slug.current == "home"][0]{
    title,
    hero
  }
`)

const hero = page?.hero

const services = [
  {
    title: 'Bare Metal Platforms',
    summary:
      'Design and build secure, automated infrastructure from the ground up.',
  },
  {
    title: 'Cloud Platforms',
    summary:
      'Build and operate platforms on AWS, Azure, GCP and sovereign clouds.',
  },
  {
    title: 'Hybrid Platforms',
    summary:
      'Connect and manage environments across data centres, clouds and edge.',
  },
  {
    title: 'Migration & Modernisation',
    summary: 'Migrate and modernise with minimal risk and continuity.',
  },
  {
    title: 'Platform Engineering',
    summary:
      'Create internal developer platforms that reduce operational burden.',
  },
]

const partners = [
  'Red Hat',
  'VMware',
  'Broadcom',
  'AWS',
  'Microsoft',
  'Google Cloud',
  'SUSE',
  'HashiCorp',
]

const caseStudies = [
  {
    title: 'Modernising a critical platform estate',
    summary:
      'We designed and delivered a secure, hybrid platform that improved reliability, reduced risk and accelerated delivery across business teams.',
    clientType: 'Platform Transformation',
  },
  {
    title: 'Building a cloud-native platform from the ground up',
    summary:
      'We built a platform that enables rapid product delivery, strong compliance and operational excellence.',
    clientType: 'Platform Transformation',
  },
]
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'What We Do | FrontierHQ'}
  description={page?.seoDescription ??
    'Platform engineering services from FrontierHQ.'}
  activeNav="/what-we-do"
>
  <main>
    <Hero {...hero} />

    <Section
      theme="dark"
      eyebrow="What We Do"
      heading="End-to-end platform engineering across any environment"
      body="We combine deep technical consultancy with hands-on delivery to design, integrate and operate platforms that scale."
    >
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-5">
        {
          services.map((service, index) => (
            <ServiceCard
              title={service.title}
              summary={service.summary}
              href="/what-we-do"
              accent={
                index % 3 === 0 ? 'green' : index % 3 === 1 ? 'cyan' : 'purple'
              }
              theme="dark"
            />
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Stronger Together"
      heading="We work with leading product companies to build what matters"
      body="We partner with best-in-class technology companies and ecosystem partners to deliver the right solutions without tying you to any single vendor."
    >
      <PartnerStrip
        partners={partners.map((name) => ({ name }))}
        variant="plain"
      />
    </Section>

    <Section
      theme="dark"
      eyebrow="Proof in Practice"
      heading="Real challenges. Real outcomes."
      headerActionLabel="View all case studies →"
      headerActionUrl="/case-studies"
    >
      <div class="grid gap-6 lg:grid-cols-2">
        {
          caseStudies.map((study, index) => (
            <CaseStudyCard
              title={study.title}
              summary={study.summary}
              href="/case-studies"
              clientType={study.clientType}
              accent={index % 2 === 0 ? 'cyan-purple' : 'cyan-blue'}
              theme="dark"
            />
          ))
        }
      </div>
    </Section>

    <CTASection
      heading="Let's build the right platform for your business."
      body="Whether you need to build, integrate, migrate or modernise — we're here to help."
      primaryCtaLabel="Let's Talk"
      primaryCtaUrl="/contact"
    />
  </main>
</Layout>
