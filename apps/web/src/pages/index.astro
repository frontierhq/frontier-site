---
import { sanity } from '../lib/sanity'

import CTASection from '../components/CTASection.astro'
import FeaturedCaseStudies from '../components/FeaturedCaseStudies.astro'
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro'
import PartnerEcosystem from '../components/PartnerEcosystem.astro'
import PlatformEstate from '../components/PlatformEstate.astro'
import WhatWeDo from '../components/WhatWeDo.astro'
import WhyProgressGetsHard from '../components/WhyProgressGetsHard.astro'

// import type { CaseStudy, Partner, Service } from '@frontier/sanity-types'

type HomePage = {
  title?: string
  seoTitle?: string
  seoDescription?: string
  hero?: Record<string, string>
}

// type HomeService = {
//   title: string
//   slug: {
//     current: string
//   }
//   summary?: string
// }

type HomePartner = {
  name: string
  slug?: {
    current: string
  }
}

type HomeCaseStudy = {
  title: string
  slug: {
    current: string
  }
  summary?: string
  clientType?: string
}

const page: HomePage | null = await sanity.fetch(`
  *[_type == "page" && slug.current == "home"][0]{
    title,
    hero
  }
`)

// const services: HomeService[] = await sanity.fetch(`
//   *[
//     _type == "service" &&
//     defined(slug.current)
//   ] | order(title asc){
//     title,
//     slug,
//     summary
//   }
// `)

const partners: HomePartner[] = await sanity.fetch(`
  *[
    _type == "partner" &&
    defined(slug.current)
  ] | order(name asc){
    name,
    slug
  }
`)

const caseStudies: HomeCaseStudy[] = await sanity.fetch(`
  *[
    _type == "caseStudy" &&
    defined(slug.current)
  ] | order(featured desc, title asc)[0...2]{
    title,
    slug,
    summary,
    clientType
  }
`)

const hero = page?.hero ?? {}

---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'What We Do | FrontierHQ'}
  description={page?.seoDescription ??
    'Platform engineering services from FrontierHQ.'}
  activeNav="/what-we-do"
>
  <main>
    <Hero {...hero} />

    <WhyProgressGetsHard />

    <WhatWeDo />

    <PlatformEstate />

    <PartnerEcosystem partners={partners} />

    <FeaturedCaseStudies caseStudies={caseStudies} />

    <CTASection
      heading="Start with the outcome you need to achieve."
      body="Understand your platform. Clarify the path forward. Build for confident change."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
    />
  </main>
</Layout>
