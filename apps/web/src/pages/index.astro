---
import { getCollection } from 'astro:content'

import CTASection from '../components/CTASection.astro'
import FeaturedCaseStudies from '../components/FeaturedCaseStudies.astro'
import Hero from '../components/Hero.astro'
import Layout from '../layouts/Layout.astro'
import PartnerEcosystem from '../components/PartnerEcosystem.astro'
import PlatformEstate from '../components/PlatformEstate.astro'
import WhatWeDo from '../components/WhatWeDo.astro'
import WhyProgressGetsHard from '../components/WhyProgressGetsHard.astro'

type HomePage = {
  title?: string
  seoTitle?: string
  seoDescription?: string
  hero?: Record<string, string>
}

// type HomeService = {
//   title: string
//   slug: {
//     current: string
//   }
//   summary?: string
// }

type HomePartner = {
  name: string
  slug?: {
    current: string
  }
}

type HomeCaseStudy = {
  title: string
  slug: {
    current: string
  }
  summary?: string
  clientType?: string
}

const page = (await getCollection('pages')).find(
  (entry) => entry.data.slug === 'home'
)
const partners: HomePartner[] = (await getCollection('partners'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .map(({ data }) => ({ name: data.name, slug: { current: data.slug } }))
const caseStudies: HomeCaseStudy[] = (await getCollection('caseStudies'))
  .sort(
    (a, b) =>
      Number(b.data.featured ?? false) - Number(a.data.featured ?? false) ||
      a.data.title.localeCompare(b.data.title)
  )
  .slice(0, 2)
  .map(({ data }) => ({
    title: data.title,
    slug: { current: data.slug },
    summary: data.summary,
    clientType: data.clientType,
  }))

const pageData: HomePage | undefined = page?.data
const hero = pageData?.hero ?? {}
---

<Layout
  title={pageData?.seoTitle ??
    pageData?.title ??
    'Platform Engineering for Real-World Environments | FrontierHQ'}
  description={pageData?.seoDescription ??
    'Design, integration and hands-on platform engineering across bare metal, cloud, hybrid and Kubernetes environments.'}
  activeNav="/what-we-do"
>
  <main>
    <Hero {...hero} />

    <WhyProgressGetsHard />

    <WhatWeDo />

    <PlatformEstate />

    <PartnerEcosystem partners={partners} />

    <FeaturedCaseStudies caseStudies={caseStudies} />

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What does your platform need to make possible?"
      body="Tell us what you need to achieve. We’ll help you see the whole system, make risk visible and find a practical path forward."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
    />
  </main>
</Layout>
