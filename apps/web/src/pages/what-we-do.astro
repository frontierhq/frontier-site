---
import type { Page } from '@frontier/sanity-types'
import { sanity } from '../lib/sanity'

import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import ServiceCard from '../components/ServiceCard.astro'
import CTASection from '../components/CTASection.astro'

type WhatWeDoPage = Pick<Page, 'title' | 'seoTitle' | 'seoDescription' | 'hero'>

const page = await sanity.fetch<WhatWeDoPage | null>(`
  *[_type == "page" && slug.current == "what-we-do"][0]{
    title,
    seoTitle,
    seoDescription,
    hero
  }
`)

const hero = page?.hero ?? {}

const platformAreas = [
  {
    title: 'Data Centre & Infrastructure Platforms',
    summary:
      'Bare metal, Linux, virtualisation, provisioning and lifecycle automation for reliable data centre infrastructure.',
    href: '/services/bare-metal-platforms',
    accent: 'green',
  },
  {
    title: 'Cloud & Hybrid Platforms',
    summary:
      'Public cloud, private cloud and hybrid integration built around your operating model and real-world environment.',
    href: '/services/cloud-platforms',
    accent: 'cyan',
  },
  {
    title: 'Kubernetes & Cloud Native',
    summary:
      'Production-ready Kubernetes platforms, developer workflows and observability for modern applications.',
    href: '/services/kubernetes-platforms',
    accent: 'purple',
  },
  {
    title: 'Migration & Modernisation',
    summary:
      'Risk-managed platform and application change that maintains operational continuity as you move forward.',
    href: '/services/migrations-and-modernisation',
    accent: 'green',
  },
]

const deliveryCapabilities = [
  {
    title: 'Platform engineering & delivery workflows',
    body: 'We build the internal platforms, automation and delivery practices that make the right path easier for engineering teams.',
  },
  {
    title: 'Consulting & integration',
    body: 'We bring the right technologies, suppliers and decisions together around the outcome your organisation needs.',
  },
  {
    title: 'Enablement for lasting change',
    body: 'We work alongside your teams so the platform can be understood, operated and evolved with confidence.',
  },
]
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'What We Do | FrontierHQ'}
  description={page?.seoDescription ??
    'Platform engineering services from FrontierHQ.'}
  activeNav="/what-we-do"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Across the Platform Estate"
      heading="Your platform should support what comes next."
      body="From bare metal to Kubernetes, we help you connect the environments you already run and build stronger foundations for change."
      theme="light"
    >
      <div class="grid gap-6 md:grid-cols-2">
        {
          platformAreas.map((area) => (
            <ServiceCard
              title={area.title}
              summary={area.summary}
              href={area.href}
              accent={area.accent}
              alignTitle
            />
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="How Frontier Helps"
      heading="Bring the whole platform around your outcome."
      body="We combine hands-on engineering, integration and enablement so your teams can see the path forward and make the next change with confidence."
      theme="dark"
    >
      <div class="grid gap-6 md:grid-cols-3">
        {
          deliveryCapabilities.map((capability) => (
            <div class="border border-frontier-cyan/10 bg-white/5 p-8">
              <div class="frontier-gradient-green-cyan mb-6 h-1 w-16 rounded-full" />
              <h3 class="text-xl font-bold text-frontier-white">
                {capability.title}
              </h3>
              <p class="mt-4 text-sm leading-7 text-frontier-light-grey">
                {capability.body}
              </p>
            </div>
          ))
        }
      </div>
    </Section>

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What do you need your platform to make possible?"
      body="Start with the outcome. We’ll help you understand the platform you have, make the path visible and build the foundations for confident change."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See Case Studies"
      secondaryCtaUrl="/case-studies"
    />
  </main>
</Layout>
