---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import PartnerCard from '../../components/PartnerCard.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
import { sanity } from '../../lib/sanity'

type PartnerListItem = {
  name: string
  slug: {
    current: string
  }
  category?: string
  summary?: string
  featured?: boolean
  partnerType?: 'vendor' | 'var'
}

const page = await sanity.fetch(`
  *[_type == "page" && slug.current == "partners"][0]{
    title, seoTitle, seoDescription, hero
  }
`)

const partners: PartnerListItem[] = await sanity.fetch(`
  *[_type == "partner" && defined(slug.current)] | order(featured desc, name asc){
    name,
    slug,
    category,
    summary,
    featured,
    partnerType
  }
`)

const vendors = partners.filter(
  (p) => !p.partnerType || p.partnerType === 'vendor'
)
const vars = partners.filter((p) => p.partnerType === 'var')

const hero = page?.hero ?? {
  eyebrow: 'Partners',
  headingPrimary: 'Independent thinking.',
  headingAccent: 'Strong product partnerships.',
  subHeading:
    'We work with leading product companies and ecosystem partners to design, integrate and build platforms that fit your environment — not a single vendor’s ideal architecture.',
}
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'Partners | FrontierHQ'}
  description={page?.seoDescription ??
    'FrontierHQ partner ecosystem and product vendor relationships.'}
  activeNav="/partners"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Technology Partners"
      heading="We integrate the right technologies into coherent platforms."
      body="Modern platforms are built from product ecosystems, not a single tool. Frontier helps organisations select, integrate and operate technologies across infrastructure, cloud, Kubernetes, security, observability and delivery workflows."
      theme="light"
    >
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          vendors.map((partner, index) => (
            <PartnerCard
              name={partner.name}
              summary={partner.summary ?? ''}
              category={partner.category ?? ''}
              href={`/partners/${partner.slug.current}`}
              accent={
                index % 3 === 0 ? 'green' : index % 3 === 1 ? 'cyan' : 'purple'
              }
              theme="light"
            />
          ))
        }
      </div>
    </Section>

    {
      vars.length > 0 && (
        <Section
          eyebrow="Value Added Resellers"
          heading="Reseller partnerships."
          body="Our reseller partners extend our reach and provide local delivery capacity across the region."
          theme="light"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {vars.map((partner, index) => (
              <PartnerCard
                name={partner.name}
                summary={partner.summary ?? ''}
                category={partner.category ?? ''}
                href={`/partners/${partner.slug.current}`}
                accent={
                  index % 3 === 0
                    ? 'green'
                    : index % 3 === 1
                      ? 'cyan'
                      : 'purple'
                }
                theme="light"
              />
            ))}
          </div>
        </Section>
      )
    }

    <Section
      eyebrow="Our Position"
      heading="Partnered, but not vendor-led."
      body="We value strong product relationships, but our work starts with your operating environment, constraints and goals. That means we choose and integrate technologies based on what your platform needs to run reliably — not what one vendor wants to sell."
      theme="dark"
    />

    <CTASection
      eyebrow="Start the conversation"
      heading="Need help integrating product technologies into your platform?"
      body="We help organisations design, integrate and operate platforms across vendor ecosystems and real-world environments."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See What We Do"
      secondaryCtaUrl="/what-we-do"
    />
  </main>
</Layout>
