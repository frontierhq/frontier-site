---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import PartnerCard from '../../components/PartnerCard.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
import { getCollection } from 'astro:content'

type PartnerListItem = {
  name: string
  slug: {
    current: string
  }
  category?: string
  summary?: string
  featured?: boolean
  partnerType?: 'vendor' | 'var'
}

const page = (await getCollection('pages')).find(
  (entry) => entry.data.slug === 'partners'
)
const partners: PartnerListItem[] = (await getCollection('partners'))
  .sort(
    (a, b) =>
      Number(b.data.featured ?? false) - Number(a.data.featured ?? false) ||
      a.data.name.localeCompare(b.data.name)
  )
  .map(({ data }) => ({
    name: data.name,
    slug: { current: data.slug },
    category: data.category,
    summary: data.summary,
    featured: data.featured,
    partnerType: data.partnerType,
  }))

const vendors = partners.filter(
  (p) => !p.partnerType || p.partnerType === 'vendor'
)
const vars = partners.filter((p) => p.partnerType === 'var')

const hero = page?.data.hero ?? {
  eyebrow: 'Partners',
  headingPrimary: 'Build around your outcome.',
  headingAccent: 'Keep your options open.',
  subHeading:
    'We bring the right product companies and ecosystem partners together around the environment you run and what your teams need to achieve.',
}
---

<Layout
  title={page?.data.seoTitle ??
    page?.data.title ??
    'Technology Partners | Frontier'}
  description={page?.data.seoDescription ??
    "See how Frontier integrates leading technologies into secure, reliable platforms built around each customer's environment and goals."}
  activeNav="/partners"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Technology Partners"
      heading="Your platform needs technologies that work together."
      body="We help you select, integrate and operate technologies across infrastructure, cloud, Kubernetes, security, observability and delivery workflows."
      theme="light"
    >
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          vendors.map((partner, index) => (
            <PartnerCard
              name={partner.name}
              summary={partner.summary ?? ''}
              category={partner.category ?? ''}
              href={`/partners/${partner.slug.current}`}
              accent={
                index % 3 === 0 ? 'green' : index % 3 === 1 ? 'cyan' : 'purple'
              }
              theme="light"
            />
          ))
        }
      </div>
    </Section>

    {
      vars.length > 0 && (
        <Section
          eyebrow="Value Added Resellers"
          heading="Delivery capacity where your programme needs it."
          body="Our reseller relationships add technology reach and local delivery capacity around the outcome you need."
          theme="light"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {vars.map((partner, index) => (
              <PartnerCard
                name={partner.name}
                summary={partner.summary ?? ''}
                category={partner.category ?? ''}
                href={`/partners/${partner.slug.current}`}
                accent={
                  index % 3 === 0
                    ? 'green'
                    : index % 3 === 1
                      ? 'cyan'
                      : 'purple'
                }
                theme="light"
              />
            ))}
          </div>
        </Section>
      )
    }

    <Section
      eyebrow="Our Position"
      heading="Your outcome sets the direction."
      body="Strong product relationships give you more options. We choose and integrate technologies around your operating environment, constraints and goals."
      theme="dark"
    />

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What does your platform need to bring together?"
      body="Tell us about the environment and outcome. We’ll help you make the options visible and integrate the right technologies."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See What We Do"
      secondaryCtaUrl="/what-we-do"
    />
  </main>
</Layout>
