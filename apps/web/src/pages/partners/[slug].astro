---
import { getCollection } from 'astro:content'

import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
type RelatedService = {
  title: string
  slug: {
    current: string
  }
  summary?: string
}

type PartnerPage = {
  name: string
  category?: string
  summary?: string
  overview?: string
  website?: string
  products: string[]
  capabilities: string[]
  relatedServices: RelatedService[]
}

export async function getStaticPaths() {
  const partners = await getCollection('partners')
  return partners.map((partner) => ({
    params: { slug: partner.data.slug },
    props: {
      partner: {
        ...partner.data,
        relatedServices: partner.data.relatedServices.map((service) => ({
          ...service,
          slug: { current: service.slug },
        })),
      },
    },
  }))
}

const { partner } = Astro.props as { partner: PartnerPage }

const products = partner?.products ?? []
const capabilities = partner?.capabilities ?? []
const relatedServices = partner?.relatedServices ?? []

const hero = {
  eyebrow: partner?.category ?? 'Partner',
  headingPrimary: partner?.name ?? 'Partner',
  headingAccent: '',
  subHeading: partner?.summary ?? '',
}
---

<Layout
  title={`${partner?.name ?? 'Partner'} | FrontierHQ`}
  description={partner?.summary ?? 'A FrontierHQ partner ecosystem page.'}
  activeNav="/partners"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Overview"
      heading={`How ${partner?.name ?? 'this technology'} fits your platform.`}
      body={partner?.overview}
      theme="light"
    />

    {
      products?.length > 0 && (
        <Section eyebrow="Products" heading="Technology in scope." theme="dark">
          <div class="flex flex-wrap gap-3">
            {products.map((product) => (
              <span class="rounded-full border border-frontier-cyan/20 bg-white/5 px-4 py-2 text-sm font-semibold text-frontier-light-grey">
                {product}
              </span>
            ))}
          </div>
        </Section>
      )
    }

    {
      capabilities?.length > 0 && (
        <Section
          eyebrow="Where We Help"
          heading="What this can help your team achieve."
          theme="light"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {capabilities.map((capability, index) => (
              <article class="border border-frontier-light-grey bg-frontier-white p-8">
                <div
                  class:list={[
                    'mb-6 h-1 w-16 rounded-full',
                    index % 3 === 0 && 'frontier-gradient-green-cyan',
                    index % 3 === 1 && 'frontier-gradient-cyan-blue',
                    index % 3 === 2 && 'frontier-gradient-cyan-purple',
                  ]}
                />
                <p class="text-lg font-semibold text-frontier-dark">
                  {capability}
                </p>
              </article>
            ))}
          </div>
        </Section>
      )
    }

    {
      relatedServices?.length > 0 && (
        <Section
          eyebrow="Related Services"
          heading="Where this fits into our platform work."
          theme="dark"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {relatedServices.map((service) => (
              <a
                href={`/services/${service.slug.current}`}
                class="group border border-frontier-cyan/10 bg-white/5 p-8 transition hover:border-frontier-cyan/30"
              >
                <h3 class="text-2xl font-bold text-frontier-white">
                  {service.title}
                </h3>
                <p class="mt-5 text-sm leading-7 text-frontier-light-grey">
                  {service.summary}
                </p>
                <p class="mt-8 text-sm font-semibold text-frontier-green transition group-hover:text-frontier-cyan">
                  View service →
                </p>
              </a>
            ))}
          </div>
        </Section>
      )
    }

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading={`What should ${partner?.name ?? 'this technology'} make possible for your team?`}
      body="Tell us about the environment and outcome. We’ll help you integrate the technology into a platform your teams can operate with confidence."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See What We Do"
      secondaryCtaUrl="/what-we-do"
    />
  </main>
</Layout>
