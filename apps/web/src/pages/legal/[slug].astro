---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/Section.astro'
import {sanity} from '../../lib/sanity'
import {PortableText} from 'astro-portabletext'

export async function getStaticPaths() {
  const pages = await sanity.fetch(`
    *[
      _type == "page" &&
      slug.current in ["privacy", "terms"]
    ]{
      "slug": slug.current
    }
  `)

  return pages.map((page) => ({
    params: {
      slug: page.slug,
    },
  }))
}

const {slug} = Astro.params

const page = await sanity.fetch(
  `
    *[
      _type == "page" &&
      slug.current == $slug
    ][0]{
      title,
      seoTitle,
      seoDescription,
      body
    }
  `,
  {slug}
)

if (!page) {
  throw new Error(`Legal page not found for slug: ${slug}`)
}
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'Legal | FrontierHQ'}
  description={page?.seoDescription ?? 'FrontierHQ legal information.'}
  navVariant="light"
>
  <main class="bg-frontier-white">
    <Section
      eyebrow="Legal"
      heading={page.title}
      theme="light"
      container="narrow"
    >
      <article
        class="
          prose
          prose-lg
          max-w-none
          prose-headings:text-frontier-dark
          prose-p:text-frontier-mid-grey
          prose-li:text-frontier-mid-grey
          prose-strong:text-frontier-dark
          prose-a:text-frontier-mid-green
        "
      >
        {page?.body && <PortableText value={page.body} />}
      </article>
    </Section>
  </main>
</Layout>
