---
import Layout from '../../layouts/Layout.astro'

import Section from '../../components/Section.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const pages = await getCollection('legal')
  return pages.map((page) => ({
    params: { slug: page.data.slug },
    props: { page },
  }))
}

const { page } = Astro.props as { page: CollectionEntry<'legal'> }
const { Content } = await render(page)
---

<Layout
  title={page.data.seoTitle ?? page.data.title ?? 'Legal | FrontierHQ'}
  description={page.data.seoDescription ?? 'FrontierHQ legal information.'}
  navVariant="light"
>
  <main class="bg-frontier-white">
    <Section
      eyebrow="Legal"
      heading={page.data.title}
      theme="light"
      container="narrow"
    >
      <article
        class="prose
          prose-lg
          max-w-none
          prose-headings:text-frontier-dark
          prose-p:text-frontier-mid-grey
          prose-li:text-frontier-mid-grey
          prose-strong:text-frontier-dark
          prose-a:text-frontier-mid-green"
      >
        <Content />
      </article>
    </Section>
  </main>
</Layout>
