---
import MembershipsAndCertifications from '../components/MembershipsAndCertifications.astro'
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import CTASection from '../components/CTASection.astro'
import { sanity } from '../lib/sanity'

const page = await sanity.fetch(`
  *[_type == "page" && slug.current == "about"][0]{
    title,
    seoTitle,
    seoDescription,
    hero
  }
`)

const hero = page?.hero ?? {
  eyebrow: 'About Frontier',
  headingPrimary: 'Build the platform your teams need',
  headingAccent: 'for what comes next.',
  subHeading:
    'Frontier works alongside your teams to understand the whole environment, make risk visible and turn sound platform decisions into working systems.',
}
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'About | FrontierHQ'}
  description={page?.seoDescription ??
    'About FrontierHQ and our approach to real-world platform engineering.'}
  activeNav="/about"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Who We Are"
      heading="Platform engineering for the environments your teams actually run."
      body="We design, integrate and build the foundations your engineering teams depend on across bare metal, cloud, hybrid, Kubernetes, CI/CD and developer platforms. We stop short of application feature development, leaving product teams free to focus on what they do best."
      theme="light"
    />

    <Section
      eyebrow="What We Believe"
      heading="Good platforms are shaped by operational reality."
      theme="dark"
    >
      <div class="grid gap-6 md:grid-cols-2">
        {
          [
            [
              'Platforms should fit the business',
              'The right platform is not a vendor reference architecture. It reflects your constraints, teams, risks and operating model.',
            ],
            [
              'Confidence comes from visible delivery',
              'We make pragmatic decisions, do the engineering work and leave teams with systems they can understand and operate.',
            ],
            [
              'Security starts in the foundations',
              'Control, resilience and compliance work best when they are designed into the platform from the start — not added later.',
            ],
            [
              'Platform engineering is an enablement function',
              'The goal is not to own everything. The goal is to give teams reliable foundations, clearer paths and less operational friction.',
            ],
          ].map(([title, body]) => (
            <article class="border border-frontier-cyan/10 bg-white/5 p-8">
              <div class="frontier-gradient-green-cyan mb-6 h-1 w-16 rounded-full" />
              <h3 class="text-2xl font-bold text-frontier-white">{title}</h3>
              <p class="mt-5 text-sm leading-7 text-frontier-light-grey">
                {body}
              </p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="How We Engage"
      heading="Advice that reaches production."
      body="We help your teams make confident platform decisions, bring the right technologies together and carry the work through to systems they can operate in production."
      theme="light"
    >
      <div class="grid gap-6 md:grid-cols-3">
        {
          [
            [
              'Advise',
              'We help define platform direction, architecture, operating models and delivery priorities.',
            ],
            [
              'Integrate',
              'We bring together infrastructure, cloud, Kubernetes, security, observability and delivery tooling.',
            ],
            [
              'Enable',
              'We work alongside teams so platforms can be adopted, operated and evolved with confidence.',
            ],
          ].map(([title, body]) => (
            <article class="border border-frontier-light-grey bg-frontier-white p-8">
              <h3 class="text-2xl font-bold text-frontier-dark">{title}</h3>
              <p class="mt-5 text-sm leading-7 text-frontier-mid-grey">
                {body}
              </p>
            </article>
          ))
        }
      </div>
    </Section>

    <Section
      eyebrow="Ecosystem"
      heading="Strong partnerships. Your outcome sets the direction."
      body="We work with leading product companies and ecosystem partners, then shape each decision around the environment you run and the outcome you need."
      theme="dark"
    >
      <div
        class="grid grid-cols-2 gap-6 text-xl font-bold text-frontier-light-grey md:grid-cols-4"
      >
        <span>Red Hat</span>
        <span>VMware</span>
        <span>Broadcom</span>
        <span>AWS</span>
        <span>Microsoft</span>
        <span>Google Cloud</span>
        <span>SUSE</span>
        <span>HashiCorp</span>
      </div>
    </Section>

    <MembershipsAndCertifications theme="light" />

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="Ready to make the next platform decision with confidence?"
      body="Tell us what you need your platform to make possible. We’ll help you understand the whole environment and turn the right decision into practical progress."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See Case Studies"
      secondaryCtaUrl="/case-studies"
    />
  </main>
</Layout>
