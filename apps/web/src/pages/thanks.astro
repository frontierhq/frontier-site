---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Thanks | FrontierHQ"
  description="Thanks for contacting FrontierHQ."
>
  <main class="bg-frontier-dark px-6 py-40 text-frontier-white">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-cyan">
        Message received
      </p>

      <h1 class="mt-6 text-5xl font-bold tracking-tight lg:text-6xl">
        Thanks.
      </h1>

      <p class="mt-8 text-lg leading-8 text-frontier-light-grey">
        We’ve received your message and will get back to you shortly.
      </p>

      <a
        href="/"
        class="mt-10 inline-flex rounded-md bg-frontier-green px-6 py-3 text-sm font-semibold text-frontier-dark transition hover:bg-frontier-cyan"
      >
        Return home
      </a>
    </div>
  </main>
</Layout>
