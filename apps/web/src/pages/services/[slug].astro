---
import { getCollection } from 'astro:content'

import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
type RelatedCaseStudy = {
  title: string
  slug: {
    current: string
  }
  summary?: string
}

type ServicePage = {
  title: string
  summary?: string
  overview?: string
  capabilities: string[]
  outcomes: string[]
  technologies: string[]
  relatedCaseStudies: RelatedCaseStudy[]
}

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((service) => ({
    params: { slug: service.data.slug },
    props: {
      service: {
        ...service.data,
        relatedCaseStudies: service.data.relatedCaseStudies.map((study) => ({
          ...study,
          slug: { current: study.slug },
        })),
      },
    },
  }))
}

const { service } = Astro.props as { service: ServicePage }

const hero = {
  eyebrow: 'Service',
  headingPrimary: service?.title ?? 'Service',
  headingAccent: '',
  subHeading: service?.summary ?? '',
}
const capabilities = service?.capabilities ?? []
const outcomes = service?.outcomes ?? []
const technologies = service?.technologies ?? []
const relatedCaseStudies = service?.relatedCaseStudies ?? []
---

<Layout
  title={`${service?.title ?? 'Service'} | FrontierHQ`}
  description={service?.summary ?? 'A FrontierHQ platform engineering service.'}
>
  <main>
    <PageHero {...hero} />

    <!-- OVERVIEW -->

    <Section
      eyebrow="Overview"
      heading="What this work makes possible."
      body={service?.overview ?? ''}
      theme="light"
    />

    <!-- CAPABILITIES -->

    {
      capabilities?.length > 0 && (
        <Section
          eyebrow="Capabilities"
          heading="What we bring together around your outcome."
          theme="dark"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {capabilities.map((capability, index) => (
              <article class="border border-frontier-cyan/10 bg-white/5 p-8">
                <div
                  class:list={[
                    'mb-6 h-1 w-16 rounded-full',
                    index % 3 === 0 && 'frontier-gradient-green-cyan',
                    index % 3 === 1 && 'frontier-gradient-cyan-blue',
                    index % 3 === 2 && 'frontier-gradient-cyan-purple',
                  ]}
                />

                <p class="text-lg font-semibold text-frontier-white">
                  {capability}
                </p>
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- OUTCOMES -->

    {
      outcomes?.length > 0 && (
        <Section
          eyebrow="Outcomes"
          heading="What your teams can do with confidence."
          theme="light"
        >
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {outcomes.map((outcome, index) => (
              <article class="border border-frontier-light-grey bg-frontier-white p-8">
                <div
                  class:list={[
                    'mb-6 h-1 w-16 rounded-full',
                    index % 3 === 0 && 'frontier-gradient-green-cyan',
                    index % 3 === 1 && 'frontier-gradient-cyan-blue',
                    index % 3 === 2 && 'frontier-gradient-cyan-purple',
                  ]}
                />

                <p class="text-lg font-semibold text-frontier-dark">
                  {outcome}
                </p>
              </article>
            ))}
          </div>
        </Section>
      )
    }

    <!-- TECHNOLOGIES -->

    {
      technologies?.length > 0 && (
        <Section
          eyebrow="Technologies"
          heading="Platforms and ecosystem technologies we work with."
          body="We integrate technologies into coherent operational platforms rather than treating tooling as the end goal."
          theme="dark"
        >
          <div class="flex flex-wrap gap-3">
            {technologies.map((technology) => (
              <span class="rounded-full border border-frontier-cyan/20 bg-white/5 px-4 py-2 text-sm font-semibold text-frontier-light-grey">
                {technology}
              </span>
            ))}
          </div>
        </Section>
      )
    }

    <!-- RELATED CASE STUDIES -->

    {
      relatedCaseStudies?.length > 0 && (
        <Section
          eyebrow="Related Case Studies"
          heading="Examples of this work in practice."
          theme="light"
        >
          <div class="grid gap-6 lg:grid-cols-2">
            {relatedCaseStudies.map((study) => (
              <a
                href={`/case-studies/${study.slug.current}`}
                class="group border border-frontier-light-grey bg-frontier-white p-8 transition hover:-translate-y-1 hover:border-frontier-cyan/30 hover:shadow-2xl"
              >
                <h3 class="text-2xl font-bold text-frontier-dark">
                  {study.title}
                </h3>

                <p class="mt-5 text-sm leading-7 text-frontier-mid-grey">
                  {study.summary ?? ''}
                </p>

                <p class="mt-8 text-sm font-semibold text-frontier-dark transition group-hover:text-frontier-cyan">
                  Read the case study →
                </p>
              </a>
            ))}
          </div>
        </Section>
      )
    }

    <!-- CTA -->

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What should this work make possible for your teams?"
      body="Tell us what you need to achieve. We’ll help you understand the environment, make risk visible and find a practical path forward."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See Case Studies"
      secondaryCtaUrl="/case-studies"
    />
  </main>
</Layout>
