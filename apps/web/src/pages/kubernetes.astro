---
import type { Page } from '@frontier/sanity-types'

import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import CTASection from '../components/CTASection.astro'
import IconCard from '../components/IconCard.astro'
import MembershipsAndCertifications from '../components/MembershipsAndCertifications.astro'
import { sanity } from '../lib/sanity'

type IconCardItem = {
  icon?: string
  title?: string
  body?: string
  href?: string
  linkLabel?: string
}

type IconCardSection = {
  _type: 'iconCardSection'
  eyebrow?: string
  heading?: string
  body?: string
  theme?: 'light' | 'dark'
  columns?: 2 | 3 | 4
  cards?: IconCardItem[]
}

type CertifiedExpertiseSection = {
  _type: 'certifiedExpertiseSection'
  eyebrow?: string
  heading?: string
  body?: string
  logo?: string
  logoAlt?: string
  href?: string
  linkLabel?: string
  cards?: {
    title?: string
    body?: string
  }[]
}

type KubernetesPage = Pick<
  Page,
  'title' | 'seoTitle' | 'seoDescription' | 'hero'
> & {
  sections?: Array<IconCardSection | CertifiedExpertiseSection>
}

const page: KubernetesPage | null = await sanity.fetch(`
  *[_type == "page" && slug.current == "kubernetes"][0]{
    title,
    seoTitle,
    seoDescription,
    hero,
    sections[]
  }
`)

const hero = page?.hero ?? {
  eyebrow: 'Kubernetes Certified Service Provider',
  headingPrimary: 'Certified Kubernetes expertise',
  headingAccent: 'for real-world platform environments.',
  subHeading:
    'As a Kubernetes Certified Service Provider, Frontier helps organisations design, build, operate and evolve Kubernetes platforms across cloud, hybrid and private infrastructure environments.',
}

const sections = page?.sections ?? []

const cta = {
  eyebrow: 'Start the conversation',
  heading: 'Need certified Kubernetes expertise?',
  body: 'We help organisations design, implement, support and evolve Kubernetes platforms across real-world infrastructure and cloud environments.',
  primaryCtaLabel: 'Let’s Talk',
  primaryCtaUrl: '/contact',
  secondaryCtaLabel: 'See What We Do',
  secondaryCtaUrl: '/what-we-do',
}

function getColumnsClass(columns?: number) {
  if (columns === 4) return 'lg:grid-cols-4'
  if (columns === 2) return 'lg:grid-cols-2'
  return 'lg:grid-cols-3'
}
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'Kubernetes Services | FrontierHQ'}
  description={page?.seoDescription ??
    'Kubernetes consulting, implementation, support and enablement services from FrontierHQ, a Kubernetes Certified Service Provider.'}
  activeNav="/kubernetes"
>
  <main>
    <PageHero {...hero} />

    {
      sections.map((section) => {
        if (section._type === 'certifiedExpertiseSection') {
          return (
            <Section
              eyebrow={section.eyebrow}
              heading={section.heading}
              body={section.body}
              theme="light"
            >
              <div class="grid items-center gap-10 lg:grid-cols-[0.7fr_1.3fr]">
                <a
                  href={
                    section.href ??
                    'https://www.cncf.io/training/certification/kcsp/'
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group rounded-3xl border border-frontier-light-grey bg-frontier-white p-8 transition hover:-translate-y-1 hover:border-frontier-cyan/30 hover:shadow-2xl"
                  aria-label={
                    section.logoAlt ??
                    'View Kubernetes Certified Service Provider programme'
                  }
                >
                  <img
                    src={section.logo ?? '/images/kcsp-logo.svg'}
                    alt={
                      section.logoAlt ?? 'Kubernetes Certified Service Provider'
                    }
                    class="mx-auto h-40 w-auto"
                  />

                  <p class="mt-6 text-center text-sm font-semibold text-frontier-dark transition group-hover:text-frontier-cyan">
                    {section.linkLabel ?? 'View KCSP programme'} →
                  </p>
                </a>

                <div class="grid gap-6 md:grid-cols-3">
                  {(section.cards ?? []).map((card) => (
                    <article class="rounded-3xl border border-frontier-light-grey bg-frontier-white p-8">
                      <div class="frontier-gradient-green-cyan mb-6 h-1 w-16 rounded-full" />

                      <h3 class="text-2xl font-bold text-frontier-dark">
                        {card.title}
                      </h3>

                      {card.body && (
                        <p class="mt-5 text-sm leading-7 text-frontier-mid-grey">
                          {card.body}
                        </p>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            </Section>
          )
        }

        if (section._type === 'iconCardSection') {
          const theme = section.theme ?? 'light'

          return (
            <Section
              eyebrow={section.eyebrow}
              heading={section.heading}
              body={section.body}
              theme={theme}
            >
              <div
                class:list={[
                  'grid gap-6 md:grid-cols-2',
                  getColumnsClass(section.columns),
                ]}
              >
                {(section.cards ?? []).map((card) => (
                  <IconCard {...card} theme={theme} />
                ))}
              </div>
            </Section>
          )
        }

        return null
      })
    }

    <MembershipsAndCertifications theme="light" compact />

    <CTASection {...cta} />
  </main>
</Layout>
