---
import type { Page } from '@frontier/sanity-types'
import Layout from '../layouts/Layout.astro'
import PageHero from '../components/PageHero.astro'
import Section from '../components/Section.astro'
import CTASection from '../components/CTASection.astro'
import TextCard from '../components/TextCard.astro'
import { sanity } from '../lib/sanity'

type TextCardItem = {
  title?: string
  body?: string
}

type CardSection = {
  _type: 'cardSection'
  eyebrow?: string
  heading?: string
  body?: string
  theme?: 'light' | 'dark'
  columns?: 2 | 3 | 4 | 5
  showAccent?: boolean
  cards?: TextCardItem[]
}

type HowWeWorkPage = Pick<
  Page,
  'title' | 'seoTitle' | 'seoDescription' | 'hero'
> & {
  sections?: CardSection[]
}

const page: HowWeWorkPage | null = await sanity.fetch(`
  *[_type == "page" && slug.current == "how-we-work"][0]{
    title,
    seoTitle,
    seoDescription,
    hero,
    sections[]
  }
`)

const hero = page?.hero ?? {
  eyebrow: 'How We Work',
  headingPrimary: 'Consultancy where it matters.',
  headingAccent: 'Delivery where it counts.',
  subHeading:
    'We help organisations move from platform complexity to operational clarity — combining technical strategy, product integration and hands-on delivery.',
}

const sections = page?.sections ?? []

function getColumnsClass(columns?: number) {
  if (columns === 5) return 'lg:grid-cols-5'
  if (columns === 4) return 'lg:grid-cols-4'
  if (columns === 2) return 'lg:grid-cols-2'
  return 'lg:grid-cols-3'
}
---

<Layout
  title={page?.seoTitle ?? page?.title ?? 'How We Work | FrontierHQ'}
  description={page?.seoDescription ??
    'How FrontierHQ designs, integrates and builds platform foundations.'}
  activeNav="/how-we-work"
>
  <main>
    <PageHero {...hero} />

    {
      sections.map((section) => {
        const theme = section.theme ?? 'light'

        return (
          <Section
            eyebrow={section.eyebrow}
            heading={section.heading}
            body={section.body}
            theme={theme}
          >
            <div
              class:list={[
                'grid gap-6 md:grid-cols-2',
                getColumnsClass(section.columns),
              ]}
            >
              {(section.cards ?? []).map((card) => (
                <TextCard {...card} theme={theme} />
              ))}
            </div>
          </Section>
        )
      })
    }

    <CTASection
      eyebrow="Start the conversation"
      heading="Need a platform partner that can advise and deliver?"
      body="We help organisations design, integrate and build platform foundations across bare metal, cloud, hybrid and Kubernetes environments."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See What We Do"
      secondaryCtaUrl="/what-we-do"
    />
  </main>
</Layout>
