---
import '../styles/global.css'
import {sanity} from '../lib/sanity'

import Hero from '../components/Hero.astro'
import Section from '../components/Section.astro'
import ServiceCard from '../components/ServiceCard.astro'
import CaseStudyCard from '../components/CaseStudyCard.astro'
import PartnerStrip from '../components/PartnerStrip.astro'

const page = await sanity.fetch(`
  *[_type == "page" && slug.current == "home"][0]{
    title,
    hero,
    sections[]{
      ...,
      services[]->{
        title,
        slug,
        summary,
        capabilities
      },
      caseStudies[]->{
        title,
        slug,
        summary,
        clientType,
        environment,
        metrics
      }
    }
  }
`)

const partners = await sanity.fetch(`
  *[_type == "partner" && featured == true] | order(name asc){
    name,
    category,
    website
  }
`)

const hero = page?.hero ?? {
  eyebrow: 'Platform engineering for real-world environments',
  heading: 'Most platforms start in the cloud. We build across where your business actually runs.',
  subheading:
    'From bare metal to hybrid to Kubernetes, we design and integrate platforms that are secure, reliable, and built for production.',
  primaryCtaLabel: 'Start a conversation',
  primaryCtaUrl: '/contact',
}

const sections = page?.sections ?? []
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{page?.title ?? 'FrontierHQ'}</title>
  </head>

  <body class="bg-white antialiased">
    <Hero {...hero} />

    <Section
      eyebrow="The reality"
      heading="Real platforms are not built from a single product."
      body="They span infrastructure, cloud, Kubernetes, CI/CD, security, observability, and the operational realities of your organisation. We bring those pieces together into platforms your teams can depend on."
    />

    {
      sections.map((section) => {
        if (section._type === 'textSection') {
          return (
            <Section heading={section.heading} body={section.body} />
          )
        }

        if (section._type === 'servicesSection') {
          return (
            <Section
              eyebrow="What we do"
              heading={section.heading ?? 'We design, integrate, and build platform foundations.'}
            >
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {section.services?.map((service) => (
                  <ServiceCard
                    title={service.title}
                    summary={service.summary}
                    capabilities={service.capabilities}
                    href={`/what-we-do/${service.slug.current}`}
                  />
                ))}
              </div>
            </Section>
          )
        }

        if (section._type === 'caseStudiesSection') {
          return (
            <Section
              dark
              eyebrow="Proof"
              heading={section.heading ?? 'Built for environments where reliability is not optional.'}
            >
              <div class="grid gap-6 md:grid-cols-2">
                {section.caseStudies?.map((study) => (
                  <CaseStudyCard
                    title={study.title}
                    summary={study.summary}
                    clientType={study.clientType}
                    environment={study.environment}
                    metrics={study.metrics}
                    href={`/case-studies/${study.slug.current}`}
                  />
                ))}
              </div>
            </Section>
          )
        }

        return null
      })
    }

    <Section
      eyebrow="Ecosystem"
      heading="We integrate the right technologies into coherent platforms."
      body="We are not tied to one vendor’s ideal architecture. We work with the technologies that fit your environment and make them operate as one system."
    >
      <PartnerStrip partners={partners} />
    </Section>

    <section class="bg-slate-950 text-white">
      <div class="mx-auto max-w-7xl px-6 py-24 lg:px-8">
        <div class="max-w-3xl">
          <h2 class="text-4xl font-semibold tracking-tight">
            Build the platform your teams can trust.
          </h2>
          <p class="mt-6 text-lg text-slate-300">
            From architecture through to delivery, we build the foundations your engineers depend on — not just advise on them.
          </p>
          <a
            href="/contact"
            class="mt-10 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-950 hover:bg-slate-200"
          >
            Start a conversation
          </a>
        </div>
      </div>
    </section>
  </body>
</html>
