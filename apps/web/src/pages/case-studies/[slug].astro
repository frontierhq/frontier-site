---
import { getCollection } from 'astro:content'

import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
type Metric = {
  label: string
  value: string
}

type CaseStudyPage = {
  title: string
  summary: string
  clientType?: string
  problem: string
  solution: string
  outcome: string
  environment: string[]
  metrics: Metric[]
}

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies')
  return studies.map((study) => ({
    params: { slug: study.data.slug },
    props: { study: study.data },
  }))
}

const { study } = Astro.props as { study: CaseStudyPage }

const environment = study?.environment ?? []
const metrics = study?.metrics ?? []

const hero = {
  eyebrow: study?.clientType ?? 'Case Study',
  headingPrimary: study?.title ?? 'Case Study',
  headingAccent: '',
  subHeading: study?.summary ?? '',
}
---

<Layout
  title={`${study?.title ?? 'Case Study'} | Frontier`}
  description={study?.summary ??
    'A FrontierHQ platform engineering case study.'}
  activeNav="/case-studies"
>
  <main>
    <PageHero {...hero} />

    <Section theme="light">
      <div class="grid gap-10 lg:grid-cols-[2fr_1fr]">
        <article class="space-y-24">
          {
            study?.problem && (
              <section>
                <p class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-mid-grey">
                  Challenge
                </p>
                <h2 class="mt-4 text-4xl font-bold tracking-tight text-frontier-dark">
                  What made progress difficult
                </h2>
                <p class="mt-6 text-lg leading-8 text-frontier-mid-grey">
                  {study.problem}
                </p>
              </section>
            )
          }

          {
            study?.solution && (
              <section>
                <p class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-mid-grey">
                  Approach
                </p>
                <h2 class="mt-4 text-4xl font-bold tracking-tight text-frontier-dark">
                  How Frontier helped
                </h2>
                <p class="mt-6 text-lg leading-8 text-frontier-mid-grey">
                  {study.solution}
                </p>
              </section>
            )
          }

          {
            study?.outcome && (
              <section>
                <p class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-mid-grey">
                  Outcome
                </p>
                <h2 class="mt-4 text-4xl font-bold tracking-tight text-frontier-dark">
                  What the team could do next
                </h2>
                <p class="mt-6 text-lg leading-8 text-frontier-mid-grey">
                  {study.outcome}
                </p>
              </section>
            )
          }
        </article>

        <aside class="border border-frontier-light-grey bg-frontier-white p-8">
          <h3 class="text-xl font-bold text-frontier-dark">Project details</h3>

          {
            environment?.length > 0 && (
              <div class="mt-8">
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-frontier-mid-grey">
                  Environment
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {environment.map((item) => (
                    <span class="rounded-full bg-frontier-light-grey px-3 py-1 text-xs font-semibold text-frontier-dark">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            )
          }

          {
            metrics?.length > 0 && (
              <div class="mt-8 space-y-6">
                <p class="text-xs font-bold uppercase tracking-[0.25em] text-frontier-mid-grey">
                  Metrics
                </p>

                {metrics.map((metric) => (
                  <div>
                    <p class="text-3xl font-bold text-frontier-dark">
                      {metric.value}
                    </p>
                    <p class="mt-1 text-sm text-frontier-mid-grey">
                      {metric.label}
                    </p>
                  </div>
                ))}
              </div>
            )
          }
        </aside>
      </div>
    </Section>

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What would confident change look like for your team?"
      body="Tell us what you need to achieve and what is making the next decision difficult. We’ll help you find a practical route forward."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See More Case Studies"
      secondaryCtaUrl="/case-studies"
    />
  </main>
</Layout>
