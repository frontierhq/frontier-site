---
import Layout from '../../layouts/Layout.astro'
import PageHero from '../../components/PageHero.astro'
import Section from '../../components/Section.astro'
import CTASection from '../../components/CTASection.astro'
import { getCollection } from 'astro:content'

type Metric = {
  label: string
  value: string
}

type CaseStudyListItem = {
  title: string
  slug: {
    current: string
  }
  summary?: string
  clientType?: string
  environment?: string[]
  metrics?: Metric[]
  featured?: boolean
}

const page = (await getCollection('pages')).find(
  (entry) => entry.data.slug === 'case-studies'
)
const caseStudies: CaseStudyListItem[] = (await getCollection('caseStudies'))
  .sort(
    (a, b) =>
      Number(b.data.featured ?? false) - Number(a.data.featured ?? false) ||
      a.data.title.localeCompare(b.data.title)
  )
  .map(({ data }) => ({ ...data, slug: { current: data.slug } }))

const hero = page?.data.hero ?? {
  eyebrow: 'Case Studies',
  headingPrimary: 'See how teams made',
  headingAccent: 'confident change possible.',
  subHeading:
    'Real platform challenges, the engineering choices that made risk visible and what each team could do next.',
}
---

<Layout
  title={page?.data.seoTitle ??
    page?.data.title ??
    'Platform Engineering Case Studies | Frontier'}
  description={page?.data.seoDescription ??
    'See how organisations improve reliability, reduce risk and modernise complex cloud, hybrid and Kubernetes platforms with Frontier.'}
  activeNav="/case-studies"
>
  <main>
    <PageHero {...hero} />

    <Section
      eyebrow="Proof in Practice"
      heading="The challenge is only part of the story."
      body="Each case study follows the work from the pressure behind the change to the confidence and freedom the client’s team gained."
      theme="light"
    >
      <div class="grid gap-6 lg:grid-cols-2">
        {
          caseStudies.map((study, index) => (
            <a
              href={`/case-studies/${study.slug.current}`}
              class="group overflow-hidden border border-frontier-light-grey bg-frontier-white text-frontier-dark transition hover:-translate-y-1 hover:border-frontier-cyan/40 hover:shadow-2xl"
            >
              <div
                class:list={[
                  'h-56',
                  index % 3 === 0 && 'frontier-gradient-green-cyan',
                  index % 3 === 1 && 'frontier-gradient-cyan-blue',
                  index % 3 === 2 && 'frontier-gradient-cyan-purple',
                ]}
              />

              <div class="p-8">
                <div class="flex flex-wrap gap-2">
                  {study.clientType && (
                    <span class="rounded-full bg-frontier-dark px-3 py-1 text-xs font-semibold text-frontier-white">
                      {study.clientType}
                    </span>
                  )}

                  {(study.environment ?? []).slice(0, 3).map((item) => (
                    <span class="rounded-full bg-frontier-light-grey px-3 py-1 text-xs font-semibold text-frontier-dark">
                      {item}
                    </span>
                  ))}
                </div>

                <h2 class="mt-6 text-3xl font-bold tracking-tight">
                  {study.title}
                </h2>

                {study.summary && (
                  <p class="mt-5 text-sm leading-7 text-frontier-mid-grey">
                    {study.summary}
                  </p>
                )}

                {(study.metrics ?? []).length > 0 && (
                  <div class="mt-8 grid gap-4 sm:grid-cols-2">
                    {(study.metrics ?? []).slice(0, 2).map((metric) => (
                      <div>
                        <p class="text-3xl font-bold text-frontier-dark">
                          {metric.value}
                        </p>
                        <p class="mt-1 text-xs font-semibold uppercase tracking-widest text-frontier-mid-grey">
                          {metric.label}
                        </p>
                      </div>
                    ))}
                  </div>
                )}

                <p class="mt-8 text-sm font-semibold text-frontier-dark transition group-hover:text-frontier-cyan">
                  Read the case study →
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </Section>

    <CTASection
      eyebrow="Operate predictably. Innovate safely."
      heading="What would your next platform change make possible?"
      body="Tell us where progress feels harder than it should. We’ll help make the risk visible and find a practical route forward."
      primaryCtaLabel="Let’s Talk"
      primaryCtaUrl="/contact"
      secondaryCtaLabel="See What We Do"
      secondaryCtaUrl="/what-we-do"
    />
  </main>
</Layout>
