---
import '../styles/global.css'

import Footer from '../components/Footer.astro'
import MembershipsAndCertifications from '../components/MembershipsAndCertifications.astro'
import Nav from '../components/Nav.astro'

const {
  title = 'FrontierHQ',
  description = 'Platform engineering for real-world environments.',
  activeNav = '',
  navVariant = 'dark',
} = Astro.props

const pageTitle = title.includes('Frontier') ? title : `${title} | Frontier`
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
).toString()
const isProductionDeploy =
  import.meta.env.PROD && import.meta.env.CONTEXT === 'production'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Frontier" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    {
      isProductionDeploy && (
        <>
          <!-- Privacy-friendly analytics by Plausible -->
          <script
            is:inline
            async
            src="https://plausible.io/js/pa-mCQkVx_dVk-1b34QZl55f.js"
          ></script>
          <script is:inline>
            window.plausible =
              window.plausible ||
              function () {
                ;(plausible.q = plausible.q || []).push(arguments)
              }
            plausible.init = plausible.init || function (i) {
              plausible.o = i || {}
            }
            plausible.init()
          </script>
        </>
      )
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@300;400;700;900&display=swap"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body
    class="bg-frontier-dark font-sans font-light text-frontier-white antialiased"
  >
    <header class="absolute inset-x-0 top-0 z-50">
      <Nav variant={navVariant} activeNav={activeNav} />
    </header>

    <slot />
    <MembershipsAndCertifications theme="dark" compact />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
