---
const {
  title = '',
  summary = '',
  href = '#',
  accent = 'green',
  theme = 'light',
  class: className = '',
} = Astro.props

const accentClass =
  accent === 'cyan'
    ? 'frontier-gradient-cyan-blue'
    : accent === 'purple'
      ? 'frontier-gradient-cyan-purple'
      : 'frontier-gradient-green-cyan'

const isDark = theme === 'dark'
---

<a
  href={href}
  class:list={[
    'group flex h-full flex-col transition',
    isDark
      ? 'rounded-2xl border border-frontier-cyan/10 bg-white/5 p-6 hover:border-frontier-cyan/30 hover:bg-white/10'
      : 'rounded-3xl border border-frontier-light-grey bg-frontier-white p-8 text-frontier-dark hover:-translate-y-1 hover:border-frontier-cyan/30 hover:shadow-2xl',
    className,
  ]}
>
  <div
    class:list={[
      accentClass,
      'rounded-full',
      isDark ? 'mb-5 h-1 w-12' : 'mb-6 h-1 w-16',
    ]}
  >
  </div>

  <h3
    class:list={[
      'font-bold',
      isDark ? 'text-lg text-frontier-white' : 'text-2xl tracking-tight',
    ]}
  >
    {title}
  </h3>

  <div class="mt-4 flex flex-1 flex-col">
    {
      summary && (
        <p
          class:list={[
            'text-sm leading-7',
            isDark ? 'text-frontier-light-grey' : 'text-frontier-mid-grey',
          ]}
        >
          {summary}
        </p>
      )
    }

    <p
      class:list={[
        'mt-auto pt-8 text-sm font-semibold transition',
        isDark
          ? 'text-frontier-green group-hover:text-frontier-cyan'
          : 'text-frontier-dark group-hover:text-frontier-cyan',
      ]}
    >
      Learn more →
    </p>
  </div>
</a>
