---
import Logo from './Logo.astro'

const { variant = 'dark', activeNav = '' } = Astro.props

const isLight = variant === 'light'

const navItems = [
  ['What We Do', '/what-we-do'],
  ['How We Work', '/how-we-work'],
  ['Kubernetes', '/kubernetes'],
  ['Partners', '/partners'],
  ['Case Studies', '/case-studies'],
  ['About Us', '/about'],
  ['Insights', '/insights'],
]

const linkBase = isLight
  ? 'text-frontier-dark/80 hover:text-frontier-mid-green'
  : 'text-frontier-white/80 hover:text-frontier-green'

const activeClass = isLight ? 'text-frontier-mid-green' : 'text-frontier-green'
---

<header class="absolute inset-x-0 top-0 z-50">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 lg:px-8"
  >
    <a href="/" class="flex items-center">
      <Logo variant={isLight ? 'dark' : 'light'} />
    </a>

    <div class="hidden gap-8 text-sm font-medium md:flex">
      {
        navItems.map(([label, href]) => (
          <a
            href={href}
            class:list={[
              'transition',
              linkBase,
              activeNav === href && activeClass,
            ]}
          >
            {label}
          </a>
        ))
      }
    </div>

    <a
      href="/contact"
      class:list={[
        'rounded-md px-5 py-3 text-sm font-semibold transition',
        isLight
          ? 'bg-frontier-dark text-frontier-white hover:bg-frontier-mid-green'
          : 'bg-frontier-green text-frontier-dark hover:bg-frontier-cyan',
      ]}
    >
      Let’s Talk
    </a>
  </nav>
</header>
