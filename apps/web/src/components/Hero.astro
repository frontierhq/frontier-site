---
import ClientLogoStrip from './ClientLogoStrip.astro'

const {
  eyebrow,
  headingPrimary,
  headingAccent,
  subHeading,
  primaryCtaLabel = 'Start a conversation',
  primaryCtaUrl = '/contact',
  secondaryCtaLabel = 'See What We Do',
  secondaryCtaUrl = '/services',
} = Astro.props
---

<section
  class="relative overflow-hidden bg-frontier-dark px-6 pt-36 pb-20 lg:px-8"
>
  <div class="absolute inset-0 opacity-20">
    <div
      class="frontier-gradient-cyan-purple absolute top-0 right-0 h-[500px] w-[500px] rounded-full blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_38rem]"
  >
    <div>
      <p
        class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-cyan"
      >
        {eyebrow}
      </p>

      <h1
        class="mt-6 max-w-4xl text-5xl font-bold leading-none tracking-tight sm:text-6xl lg:text-7xl"
      >
        <span class="block text-frontier-white">
          {headingPrimary}
        </span>

        <span class="mt-2 block text-frontier-green">
          {headingAccent}
        </span>
      </h1>

      <p class="mt-10 max-w-xl text-lg leading-8 text-frontier-light-grey">
        {subHeading}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={primaryCtaUrl}
          class="rounded-md bg-frontier-green px-6 py-3 text-sm font-bold text-frontier-dark transition hover:bg-frontier-cyan"
        >
          {primaryCtaLabel}
        </a>

        <a
          href={secondaryCtaUrl}
          class="rounded-md border border-frontier-cyan/30 px-6 py-3 text-sm font-bold text-frontier-white transition hover:border-frontier-cyan hover:bg-frontier-cyan/10"
        >
          {secondaryCtaLabel}
        </a>
      </div>
    </div>

    <div
      class="w-[140%] max-w-none translate-y-6 lg:w-[150%] lg:translate-y-10 [mask-image:linear-gradient(to_bottom,black_0%,black_60%,transparent_95%)] [-webkit-mask-image:linear-gradient(to_bottom,black_0%,black_60%,transparent_95%)]"
    >
      <img
        src="/images/platform-layers.svg"
        alt=""
        width="862"
        height="584"
        class="w-full [mask-image:linear-gradient(to_right,black_0%,black_50%,transparent_82%)] [-webkit-mask-image:linear-gradient(to_right,black_0%,black_50%,transparent_82%)]"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- LOGOS -->
  <ClientLogoStrip />
</section>
