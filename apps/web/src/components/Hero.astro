---
const {
  eyebrow,
  headingPrimary,
  headingAccent,
  subHeading,
  primaryCtaLabel = 'Start a conversation',
  primaryCtaUrl = '/contact',
  secondaryCtaLabel = 'See What We Do',
  secondaryCtaUrl = '/services',
} = Astro.props
---

<section
  class="relative overflow-hidden bg-frontier-dark px-6 pt-36 pb-20 lg:px-8"
>
  <div class="absolute inset-0 opacity-20">
    <div
      class="frontier-gradient-cyan-purple absolute top-0 right-0 h-[500px] w-[500px] rounded-full blur-3xl"
    >
    </div>
  </div>

  <div
    class="relative mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-2"
  >
    <div>
      <p
        class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-cyan"
      >
        {eyebrow}
      </p>

      <h1
        class="mt-6 max-w-4xl text-5xl font-extrabold leading-none tracking-tight sm:text-6xl lg:text-7xl"
      >
        <span class="block text-frontier-white">
          {headingPrimary}
        </span>

        <span class="mt-2 block text-frontier-green">
          {headingAccent}
        </span>
      </h1>

      <p class="mt-10 max-w-xl text-lg leading-8 text-frontier-light-grey">
        {subHeading}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={primaryCtaUrl}
          class="rounded-md bg-frontier-green px-6 py-3 text-sm font-semibold text-frontier-dark transition hover:bg-frontier-cyan"
        >
          {primaryCtaLabel}
        </a>

        <a
          href={secondaryCtaUrl}
          class="rounded-md border border-frontier-cyan/30 px-6 py-3 text-sm font-semibold text-frontier-white transition hover:border-frontier-cyan hover:bg-frontier-cyan/10"
        >
          {secondaryCtaLabel}
        </a>
      </div>
    </div>

    <!-- STACK CARDS -->

    <div class="relative">
      <div class="space-y-5">
        {
          [
            ['APPLICATIONS', 'Cloud-native apps · Business services'],

            [
              'KUBERNETES & PLATFORMS',
              'Services · Runtime APIs · Observability',
            ],

            [
              'CLOUD & VIRTUALISATION',
              'Public cloud · Private cloud · Networks · Storage · Identity',
            ],

            [
              'BARE METAL & INFRASTRUCTURE',
              'Servers · Provisioning · Operating systems',
            ],
          ].map(([title, body], index) => (
            <div
              class:list={[
                'rounded-3xl border p-8 shadow-2xl backdrop-blur transition hover:-translate-y-1',
                index === 0 &&
                  'border-frontier-purple/20 bg-frontier-dark-purple/30',
                index === 1 &&
                  'border-frontier-cyan/20 bg-frontier-dark-blue/30',
                index === 2 &&
                  'border-frontier-blue/20 bg-frontier-dark-cyan/30',
                index === 3 &&
                  'border-frontier-green/20 bg-frontier-dark-green/30',
              ]}
            >
              <p class="text-sm font-bold tracking-wide text-frontier-white">
                {title}
              </p>

              <p class="mt-3 text-sm leading-6 text-frontier-light-grey">
                {body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- LOGOS -->

  <div class="relative mx-auto mt-24 max-w-7xl">
    <p class="text-sm font-medium text-frontier-light-grey">
      Trusted by organisations that rely on their platforms
    </p>

    <div
      class="mt-8 grid grid-cols-2 gap-6 text-sm font-bold text-frontier-light-grey sm:grid-cols-4 lg:grid-cols-7"
    >
      <span>NatWest</span>
      <span>Octopus Energy</span>
      <span>Bank of England</span>
      <span>NHS</span>
      <span>PEPCO Group</span>
      <span>JUST EAT</span>
      <span>RS</span>
    </div>
  </div>
</section>
