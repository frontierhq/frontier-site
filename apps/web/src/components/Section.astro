---
const {
  eyebrow = '',
  heading = '',
  body = '',
  theme = 'light',
  spacing = 'default',
  container = 'default',
} = Astro.props

const isDark = theme === 'dark'

const sectionClass = isDark
  ? 'bg-frontier-dark text-frontier-white'
  : 'bg-frontier-white text-frontier-dark'

const eyebrowClass = isDark
  ? 'text-frontier-cyan'
  : 'text-frontier-mid-grey'

const bodyClass = isDark
  ? 'text-frontier-light-grey'
  : 'text-frontier-mid-grey'

const spacingClass =
  spacing === 'compact'
    ? 'py-16'
    : spacing === 'large'
      ? 'py-28'
      : 'py-24'

const containerClass =
  container === 'narrow'
    ? 'max-w-4xl'
    : 'max-w-7xl'
---

<section class:list={[sectionClass, 'px-6 lg:px-8']}>
  <div class:list={['mx-auto', containerClass, spacingClass]}>
    {(eyebrow || heading || body) && (
      <div class="max-w-4xl">
        {eyebrow && (
          <p class:list={[
            'text-sm font-bold uppercase tracking-[0.25em]',
            eyebrowClass,
          ]}>
            {eyebrow}
          </p>
        )}

        {heading && (
          <h2 class="mt-5 text-4xl font-bold tracking-tight lg:text-5xl">
            {heading}
          </h2>
        )}

        {body && (
          <p class:list={[
            'mt-8 text-lg leading-8',
            bodyClass,
          ]}>
            {body}
          </p>
        )}
      </div>
    )}

    <div class={(eyebrow || heading || body) ? 'mt-14' : ''}>
      <slot />
    </div>
  </div>
</section>
