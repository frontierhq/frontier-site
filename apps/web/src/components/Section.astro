---
const {
  eyebrow = '',
  heading = '',
  body = '',
  theme = 'light',
  spacing = 'default',
  container = 'default',
  headerActionLabel = '',
  headerActionUrl = '',
} = Astro.props

const isDark = theme === 'dark'

const sectionClass = isDark
  ? 'bg-frontier-dark text-frontier-white'
  : 'bg-frontier-white text-frontier-dark'

const eyebrowClass = isDark ? 'text-frontier-cyan' : 'text-frontier-mid-grey'

const bodyClass = isDark ? 'text-frontier-light-grey' : 'text-frontier-mid-grey'

const spacingClass =
  spacing === 'compact' ? 'py-16' : spacing === 'large' ? 'py-28' : 'py-24'

const containerClass = container === 'narrow' ? 'max-w-4xl' : 'max-w-7xl'

const hasHeader = eyebrow || heading || body
const hasAction = headerActionLabel && headerActionUrl
---

<section class:list={[sectionClass, 'px-6 lg:px-8']}>
  <div class:list={['mx-auto', containerClass, spacingClass]}>
    {
      hasHeader && (
        <div class:list={[hasAction ? 'flex items-end justify-between gap-6' : 'max-w-4xl']}>
          <div class={hasAction ? '' : 'max-w-4xl'}>
            {eyebrow && (
              <p
                class:list={[
                  'text-sm font-bold uppercase tracking-[0.25em]',
                  eyebrowClass,
                ]}
              >
                {eyebrow}
              </p>
            )}

            {heading && (
              <h2 class="mt-5 text-4xl font-bold tracking-tight lg:text-5xl">
                {heading}
              </h2>
            )}

            {body && (
              <p class:list={['mt-8 text-lg leading-8', bodyClass]}>{body}</p>
            )}
          </div>

          {hasAction && (
            <a
              href={headerActionUrl}
              class:list={[
                'hidden text-sm font-semibold transition md:block',
                isDark
                  ? 'text-frontier-green hover:text-frontier-cyan'
                  : 'text-frontier-dark hover:text-frontier-cyan',
              ]}
            >
              {headerActionLabel}
            </a>
          )}
        </div>
      )
    }

    <div class={hasHeader ? 'mt-14' : ''}>
      <slot />
    </div>
  </div>
</section>
