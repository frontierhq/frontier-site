---
type Partner = {
  name: string
  slug?: {
    current: string
  }
}

const { partners = [], variant = 'card' } = Astro.props as {
  partners?: Partner[]
  variant?: 'card' | 'plain'
}

const isPlain = variant === 'plain'
---

{
  isPlain ? (
    <div class="grid grid-cols-2 gap-8 text-xl font-bold text-frontier-mid-grey md:grid-cols-4">
      {partners.map((partner) => (
        <span>{partner.name}</span>
      ))}
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-x-16 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {partners.map((partner) =>
        partner.slug?.current ? (
          <a
            href={`/partners/${partner.slug.current}`}
            class="text-lg font-medium text-frontier-dark opacity-55 transition duration-200 hover:opacity-100 hover:text-frontier-cyan"
          >
            {partner.name}
          </a>
        ) : (
          <span class="text-lg font-medium text-frontier-dark opacity-55">
            {partner.name}
          </span>
        )
      )}
    </div>
  )
}
