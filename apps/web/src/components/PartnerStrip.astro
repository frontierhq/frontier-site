---
type Partner = {
  name: string
}

const { partners = [], variant = 'card' } = Astro.props as {
  partners?: Partner[]
  variant?: 'card' | 'plain'
}

const isPlain = variant === 'plain'
---

{
  isPlain ? (
    <div class="grid grid-cols-2 gap-8 text-xl font-bold text-frontier-light-grey md:grid-cols-4">
      {partners.map((partner) => (
        <span>{partner.name}</span>
      ))}
    </div>
  ) : (
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {partners.map((partner) => (
        <div class="flex min-h-24 items-center justify-center rounded-2xl border border-slate-200 bg-white p-4 text-center">
          <span class="text-sm font-semibold text-slate-500">
            {partner.name}
          </span>
        </div>
      ))}
    </div>
  )
}
