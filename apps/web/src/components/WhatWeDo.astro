---
import Section from './Section.astro'

const waysWeHelp = [
  {
    title: 'Understand the whole system',
    body: 'We bring the technical, operational and organisational context together. You see the full picture.',
  },
  {
    title: 'Make risk visible',
    body: 'We clarify dependencies and trade-offs. You see a practical path forward.',
  },
  {
    title: 'Bring the right pieces together',
    body: 'We bring the right people and technologies together. The focus stays on your outcome.',
  },
]
---

<Section
  eyebrow="What We Do"
  heading="Turn complexity into confidence."
  body="We work alongside your team. Together, we see the whole platform, make risk visible and build stronger foundations."
  theme="dark"
>
  <div class="grid gap-6 md:grid-cols-3">
    {
      waysWeHelp.map((way, index) => (
        <article class="border border-frontier-cyan/10 bg-white/5 p-8">
          <div
            class:list={[
              'mb-6 h-1 w-16 rounded-full',
              index === 0 && 'frontier-gradient-green-cyan',
              index === 1 && 'frontier-gradient-cyan-blue',
              index === 2 && 'frontier-gradient-cyan-purple',
            ]}
          />

          <h3 class="text-2xl font-bold text-frontier-white">
            {way.title}
          </h3>

          <p class="mt-5 text-sm leading-7 text-frontier-light-grey">
            {way.body}
          </p>
        </article>
      ))
    }
  </div>
</Section>
