---
import Section from './Section.astro'

const waysWeHelp = [
  {
    title: 'Understand the whole system',
    body: 'We bring together the technical, operational and organisational context so decisions are made with the full picture in view.',
  },
  {
    title: 'Make risk visible',
    body: 'We clarify the dependencies, trade-offs and practical paths forward, helping teams move with greater confidence.',
  },
  {
    title: 'Orchestrate around your outcome',
    body: 'We bring the right people and technologies together around what your organisation needs to achieve — not a product agenda.',
  },
]
---

<Section
  eyebrow="What We Do"
  heading="We turn platform complexity into confidence to change."
  body="Frontier works alongside your team to understand the whole platform, make risk visible and create the foundations for progress."
  theme="dark"
>
  <div class="grid gap-6 md:grid-cols-3">
    {
      waysWeHelp.map((way, index) => (
        <article class="rounded-3xl border border-frontier-cyan/10 bg-white/5 p-8">
          <div
            class:list={[
              'mb-6 h-1 w-16 rounded-full',
              index === 0 && 'frontier-gradient-green-cyan',
              index === 1 && 'frontier-gradient-cyan-blue',
              index === 2 && 'frontier-gradient-cyan-purple',
            ]}
          />

          <h3 class="text-2xl font-bold text-frontier-white">
            {way.title}
          </h3>

          <p class="mt-5 text-sm leading-7 text-frontier-light-grey">
            {way.body}
          </p>
        </article>
      ))
    }
  </div>
</Section>
