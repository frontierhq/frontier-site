---
const { theme = 'dark', compact = false } = Astro.props

const isDark = theme === 'dark'

const groups = [
  {
    title: 'Cloud Native & Open Source',
    items: [
      {
        name: 'Kubernetes Certified Service Provider',
        image: '/images/accreditations/kcsp.svg',
        href: 'https://www.cncf.io/training/certification/kcsp/',
      },
      {
        name: 'CNCF Silver Member',
        image: '/images/accreditations/cncf-member-silver-color.svg',
        href: 'https://www.cncf.io/',
      },
      {
        name: 'Linux Foundation Silver Member',
        image: '/images/accreditations/tlf-member-horizontal-silver.svg',
        href: 'https://www.linuxfoundation.org/',
      },
    ],
  },
  {
    title: 'Security & Operations',
    items: [
      {
        name: 'ISO 27001',
        image: '/images/accreditations/iso27001.svg',
      },
      {
        name: 'Cyber Essentials',
        image: '/images/accreditations/cyber-essentials.webp',
      },
    ],
  },
  {
    title: 'People & Culture',
    items: [
      {
        name: 'Great Place To Work',
        image: '/images/accreditations/great-place-to-work-logo.svg',
      },
      {
        name: 'Living Wage Employer',
        image: '/images/accreditations/living-wage-employer-logo.webp',
      },
    ],
  },
]
---

<section
  class:list={[
    'px-6 lg:px-8',
    compact ? 'py-12' : 'py-20',
    isDark
      ? 'bg-frontier-dark text-frontier-white'
      : 'bg-frontier-white text-frontier-dark',
  ]}
>
  <div class="mx-auto max-w-7xl">
    {
      !compact && (
        <div class="max-w-4xl">
          <p
            class:list={[
              'text-sm font-bold uppercase tracking-[0.25em]',
              isDark ? 'text-frontier-cyan' : 'text-frontier-mid-grey',
            ]}
          >
            Memberships & Certifications
          </p>

          <h2 class="mt-5 text-4xl font-bold tracking-tight lg:text-5xl">
            Recognised across the cloud native, open source and operational
            trust ecosystem.
          </h2>
        </div>
      )
    }

    <div
      class:list={[
        'grid gap-8',
        compact ? 'mt-0 md:grid-cols-3' : 'mt-14 lg:grid-cols-3',
      ]}
    >
      {
        groups.map((group) => (
          <div
            class:list={[
              'rounded-3xl border p-8',
              isDark
                ? 'border-frontier-cyan/10 bg-white/5'
                : 'border-frontier-light-grey bg-frontier-white',
            ]}
          >
            <h3
              class:list={[
                'text-sm font-bold uppercase tracking-[0.25em]',
                isDark ? 'text-frontier-cyan' : 'text-frontier-mid-grey',
              ]}
            >
              {group.title}
            </h3>

            <div class="mt-8 flex flex-wrap items-center gap-8">
              {group.items.map((item) => {
                const logo = (
                  <img
                    src={item.image}
                    alt={item.name}
                    class="h-14 w-auto max-w-[180px] object-contain"
                  />
                )

                return item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={item.name}
                    class="opacity-80 transition hover:opacity-100"
                  >
                    {logo}
                  </a>
                ) : (
                  <div class="opacity-80">{logo}</div>
                )
              })}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
