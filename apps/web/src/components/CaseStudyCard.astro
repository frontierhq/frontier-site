---
type Metric = {
  label: string
  value: string
}

const {
  title,
  summary,
  href,
  clientType,
  environment = [],
  metrics = [],
} = Astro.props as {
  title: string
  summary?: string
  href: string
  clientType?: string
  environment?: string[]
  metrics?: Metric[]
}
---

<a
  href={href}
  class="block rounded-3xl bg-slate-900 p-6 text-white transition hover:-translate-y-1 hover:bg-slate-800"
>
  {clientType && <p class="text-sm font-medium text-cyan-300">{clientType}</p>}

  <h3 class="mt-3 text-2xl font-semibold">{title}</h3>

  {summary && <p class="mt-4 text-sm leading-6 text-slate-300">{summary}</p>}

  {
    environment?.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {environment.map((item) => (
          <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-slate-200">
            {item}
          </span>
        ))}
      </div>
    )
  }

  {
    metrics?.length > 0 && (
      <div class="mt-8 grid grid-cols-2 gap-4">
        {metrics.slice(0, 2).map((metric) => (
          <div>
            <p class="text-2xl font-semibold">{metric.value}</p>
            <p class="text-xs text-slate-400">{metric.label}</p>
          </div>
        ))}
      </div>
    )
  }
</a>
