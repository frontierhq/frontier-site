---
type Metric = {
  label: string
  value: string
}

const {
  title,
  summary,
  href,
  clientType,
  environment = [],
  metrics = [],
  accent = 'cyan-purple',
  theme = 'light',
} = Astro.props as {
  title: string
  summary?: string
  href: string
  clientType?: string
  environment?: string[]
  metrics?: Metric[]
  accent?: 'green-cyan' | 'cyan-blue' | 'cyan-purple'
  theme?: 'light' | 'dark'
}

const isDark = theme === 'dark'

const accentClass =
  accent === 'green-cyan'
    ? 'frontier-gradient-green-cyan'
    : accent === 'cyan-blue'
      ? 'frontier-gradient-cyan-blue'
      : 'frontier-gradient-cyan-purple'
---

<a
  href={href}
  class:list={[
    'group block overflow-hidden rounded-3xl transition',
    isDark
      ? 'border border-frontier-cyan/10 bg-white/5 hover:border-frontier-cyan/30'
      : 'border border-frontier-light-grey bg-frontier-white text-frontier-dark hover:-translate-y-1 hover:border-frontier-cyan/40 hover:shadow-2xl',
  ]}
>
  <div class:list={[accentClass, 'h-56', isDark && 'opacity-70']}></div>

  <div class="p-8">
    {
      clientType && (
        <p
          class:list={[
            'text-xs font-bold uppercase tracking-[0.25em]',
            isDark ? 'text-frontier-cyan' : 'text-frontier-dark',
          ]}
        >
          {clientType}
        </p>
      )
    }

    <h3
      class:list={[
        'text-3xl font-bold',
        isDark ? 'mt-4 text-frontier-white' : 'mt-6 tracking-tight',
      ]}
    >
      {title}
    </h3>

    {
      summary && (
        <p
          class:list={[
            'mt-5 text-sm leading-7',
            isDark ? 'text-frontier-light-grey' : 'text-frontier-mid-grey',
          ]}
        >
          {summary}
        </p>
      )
    }

    {
      (environment ?? []).length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {(environment ?? []).slice(0, 3).map((item) => (
            <span
              class:list={[
                'rounded-full px-3 py-1 text-xs font-semibold',
                isDark
                  ? 'bg-white/10 text-frontier-light-grey'
                  : 'bg-frontier-light-grey text-frontier-dark',
              ]}
            >
              {item}
            </span>
          ))}
        </div>
      )
    }

    {
      (metrics ?? []).length > 0 && (
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {(metrics ?? []).slice(0, 2).map((metric) => (
            <div>
              <p
                class:list={[
                  'text-3xl font-bold',
                  isDark ? 'text-frontier-white' : 'text-frontier-dark',
                ]}
              >
                {metric.value}
              </p>
              <p
                class:list={[
                  'mt-1 text-xs font-semibold uppercase tracking-widest',
                  isDark
                    ? 'text-frontier-light-grey'
                    : 'text-frontier-mid-grey',
                ]}
              >
                {metric.label}
              </p>
            </div>
          ))}
        </div>
      )
    }

    <p
      class:list={[
        'mt-8 text-sm font-semibold transition',
        isDark
          ? 'text-frontier-green group-hover:text-frontier-cyan'
          : 'text-frontier-dark group-hover:text-frontier-cyan',
      ]}
    >
      Read the case study →
    </p>
  </div>
</a>
