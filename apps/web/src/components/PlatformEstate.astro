---
import Section from './Section.astro'
import ServiceCard from './ServiceCard.astro'

const areas = [
  {
    title: 'Data Centre & Infrastructure Platforms',
    summary:
      'Bare metal, Linux, virtualisation, provisioning and lifecycle automation for reliable data centre infrastructure.',
    href: '/services/bare-metal-platforms',
  },
  {
    title: 'Cloud & Hybrid Platforms',
    summary:
      'Public cloud, private cloud, hybrid integration and platform operations across real-world environments.',
    href: '/services/hybrid-platforms',
  },
  {
    title: 'Kubernetes & Cloud Native',
    summary:
      'Kubernetes, OpenShift, GitOps, observability and developer workflows for modern application platforms.',
    href: '/kubernetes',
  },
  {
    title: 'Migration & Modernisation',
    summary:
      'Risk-managed platform and application migration without losing operational control.',
    href: '/services/migrations-and-modernisation',
  },
]
---

<Section
  eyebrow="Across the Platform Estate"
  heading="Platform work across the environments your business actually runs in."
  body="From bare metal to Kubernetes, these are the parts of the platform estate where we help teams create stronger foundations for change."
  theme="dark"
>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      areas.map((area, index) => (
        <ServiceCard
          title={area.title}
          summary={area.summary}
          href={area.href}
          accent={
            index % 3 === 0 ? 'green' : index % 3 === 1 ? 'cyan' : 'purple'
          }
          alignTitle
        />
      ))
    }
  </div>
</Section>
