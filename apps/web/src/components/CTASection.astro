---
const {
  eyebrow = '',
  heading = '',
  body = '',
  primaryCtaLabel = 'Let’s Talk',
  primaryCtaUrl = '/contact',
  secondaryCtaLabel = '',
  secondaryCtaUrl = '',
  dark = false,
} = Astro.props
---

<section
  class:list={[
    'px-6 py-20 lg:px-8',
    dark
      ? 'bg-frontier-dark text-frontier-white'
      : 'bg-frontier-white text-frontier-dark',
  ]}
>
  <div class="mx-auto max-w-7xl">
    <div
      class="overflow-hidden rounded-[2rem] border border-frontier-cyan/10 bg-gradient-to-br from-frontier-dark via-frontier-dark-blue to-frontier-dark-purple p-10 lg:p-14"
    >
      <div class="max-w-4xl">
        {
          eyebrow && (
            <p class="text-sm font-bold uppercase tracking-[0.25em] text-frontier-cyan">
              {eyebrow}
            </p>
          )
        }

        <h2
          class="mt-5 text-4xl font-bold tracking-tight text-frontier-white lg:text-5xl"
        >
          {heading}
        </h2>

        {
          body && (
            <p class="mt-6 max-w-2xl text-lg leading-8 text-frontier-light-grey">
              {body}
            </p>
          )
        }

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={primaryCtaUrl}
            class="rounded-md bg-frontier-green px-6 py-3 text-sm font-semibold text-frontier-dark transition hover:bg-frontier-cyan"
          >
            {primaryCtaLabel}
          </a>

          {
            secondaryCtaLabel && (
              <a
                href={secondaryCtaUrl}
                class="rounded-md border border-frontier-cyan/30 px-6 py-3 text-sm font-semibold text-frontier-white transition hover:border-frontier-cyan hover:bg-frontier-cyan/10"
              >
                {secondaryCtaLabel}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
