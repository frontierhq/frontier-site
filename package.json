{
  "name": "frontier-site",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:sheriff": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "dev:web:host": "npm run dev -w apps/web -- --host 0.0.0.0",
    "dev:sheriff:host": "npm run dev -w apps/sheriff -- --host 0.0.0.0",
    "build:sheriff": "npm run build -w apps/sheriff",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build:web && npm run test:e2e",
    "fix": "npm run lint:fix && npm run format",
    "typecheck": "npm run typecheck -w apps/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "content:validate": "npm run typecheck && npm run build:web"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.59.2"
  }
}
